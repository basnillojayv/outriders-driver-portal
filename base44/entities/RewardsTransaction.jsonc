{
  "name": "RewardsTransaction",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string",
      "description": "Base44 Member entity ID"
    },
    "lhs_member_id": {
      "type": "string",
      "description": "Human-readable LHS-XXXXX member ID"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "earned",
        "redeemed",
        "expired",
        "adjusted"
      ],
      "description": "Type of credit event"
    },
    "source": {
      "type": "string",
      "enum": [
        "referral",
        "manual",
        "milestone",
        "system"
      ],
      "description": "What triggered this transaction"
    },
    "credit_amount": {
      "type": "number",
      "description": "Credits added (positive) or removed (negative)"
    },
    "balance_after": {
      "type": "number",
      "description": "Member's total credit balance after this transaction"
    },
    "related_contact_id": {
      "type": "string",
      "description": "GHL contact ID of the referred person (if referral source)"
    },
    "related_member_id": {
      "type": "string",
      "description": "Base44 Member ID of the referred person (if referral source)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable explanation of this transaction"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this transaction occurred"
    },
    "raw_payload": {
      "type": "string",
      "description": "Raw JSON payload from the source event (for auditability)"
    }
  },
  "required": [
    "member_id",
    "event_type",
    "source",
    "credit_amount"
  ]
}