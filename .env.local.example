# Copy to .env.local to activate. .env* is gitignored.

# Skip the Base44 login flow during local development. Only has an effect under
# `npm run dev` — Vite compiles it out of production builds.
VITE_DEV_BYPASS_AUTH=true

# Who you're signed in as while the bypass is on.
# Set role to 'admin' to reach the /admin portal; anything else is a driver.
VITE_DEV_BYPASS_ROLE=admin
VITE_DEV_BYPASS_EMAIL=dev@linehaulstation.com
